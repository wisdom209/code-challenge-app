					],
					"tests": [
						{
							"args": [
								"str"
							],
							"init": {
								"str": "Hello"
							},
							"returns": "None",
							"stdout": "Hello"
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": ""
							},
							"returns": "None",
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "42"
							},
							"returns": "None",
							"stdout": "42"
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "HelloWorld"
							},
							"returns": "None",
							"stdout": "HelloWorld"
						}
					],
					"description": "Create a function that displays a string of characters on the standard output."
				},
				{
					"name": "ft_putnbr",
					"prototype": "void ft_putnbr(int nb);",
					"type": "function",
					"allowed": [
						"write"
					],
					"tests": [
						{
							"args": [
								"nb"
							],
							"init": {
								"nb": 42
							},
							"returns": "None",
							"stdout": "42"
						},
						{
							"args": [
								"nb"
							],
							"init": {
								"nb": 0
							},
							"returns": "None",
							"stdout": "0"
						},
						{
							"args": [
								"nb"
							],
							"init": {
								"nb": -42
							},
							"returns": "None",
							"stdout": "-42"
						},
						{
							"args": [
								"nb"
							],
							"init": {
								"nb": 2147483647
							},
							"returns": "None",
							"stdout": "2147483647"
						},
						{
							"args": [
								"nb"
							],
							"init": {
								"nb": -2147483648
							},
							"returns": "None",
							"stdout": "-2147483648"
						}
					],
					"description": "Create a function that displays the number entered as a parameter. The function has to be able to display all possible values within an int type variable."
				},
				{
					"name": "ft_atoi",
					"prototype": "int ft_atoi(char *str);",
					"type": "function",
					"allowed": [],
					"tests": [
						{
							"args": [
								"str"
							],
							"init": {
								"str": "42"
							},
							"returns": 42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   -42"
							},
							"returns": -42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   ---+--+1234ab567"
							},
							"returns": -1234,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   +42"
							},
							"returns": 42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   -+42"
							},
							"returns": -42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   --42"
							},
							"returns": 42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   +-42"
							},
							"returns": -42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   abc"
							},
							"returns": 0,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   42abc"
							},
							"returns": 42,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   -2147483648"
							},
							"returns": -2147483648,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "   2147483647"
							},
							"returns": 2147483647,
							"stdout": ""
						}
					],
					"description": "Write a function that converts the initial portion of the string pointed by str to its int representation. The string can start with an arbitrary amount of white space, followed by an arbitrary amount of + and - signs, and then digits. The function should read until the string stops following the rules and return the number found until now. Do not handle overflow or underflow."
				},
				{
					"name": "ft_putnbr_base",
					"prototype": "void ft_putnbr_base(int nbr, char *base);",
					"type": "function",
					"allowed": [
						"write"
					],
					"tests": [
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "0123456789"
							},
							"returns": "None",
							"stdout": "42"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": -42,
								"base": "0123456789"
							},
							"returns": "None",
							"stdout": "-42"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 0,
								"base": "0123456789"
							},
							"returns": "None",
							"stdout": "0"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "01"
							},
							"returns": "None",
							"stdout": "101010"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": -42,
								"base": "01"
							},
							"returns": "None",
							"stdout": "-101010"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "0123456789ABCDEF"
							},
							"returns": "None",
							"stdout": "2A"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 255,
								"base": "0123456789ABCDEF"
							},
							"returns": "None",
							"stdout": "FF"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": -255,
								"base": "0123456789ABCDEF"
							},
							"returns": "None",
							"stdout": "-FF"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "poneyvif"
							},
							"returns": "None",
							"stdout": "vn"
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": ""
							},
							"returns": "None",
							"stdout": ""
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "0"
							},
							"returns": "None",
							"stdout": ""
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "01234567890"
							},
							"returns": "None",
							"stdout": ""
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "01234+6789"
							},
							"returns": "None",
							"stdout": ""
						},
						{
							"args": [
								"nbr",
								"base"
							],
							"init": {
								"nbr": 42,
								"base": "01234-6789"
							},
							"returns": "None",
							"stdout": ""
						}
					],
					"description": "Create a function that displays a number in a base system in the terminal. The number is given as an int, and the radix as a string. The function must handle negative numbers. If the base is invalid (empty, size 1, duplicate characters, or contains '+' or '-'), nothing should be displayed."
				},
