			"title": "Chapter I",
			"exercises": [
				{
					"name": "ft_strlen",
					"prototype": "int ft_strlen(char *str);",
					"type": "function",
					"allowed": [],
					"tests": [
						{
							"args": [
								"str"
							],
							"init": {
								"str": "Hello"
							},
							"returns": 5,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": ""
							},
							"returns": 0,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "42"
							},
							"returns": 2,
							"stdout": ""
						},
						{
							"args": [
								"str"
							],
							"init": {
								"str": "Hello World!"
							},
							"returns": 12,
							"stdout": ""
						}
					],
					"description": "Create a function that counts and returns the number of characters in a string."
				},
				{
					"name": "ft_putstr",
					"prototype": "void ft_putstr(char *str);",
					"type": "function",
					"allowed": [
