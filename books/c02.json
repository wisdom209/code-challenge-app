				{
					"name": "ft_strcpy",
					"prototype": "char *ft_strcpy(char *dest, char *src);",
					"type": "function",
					"allowed": [],
					"tests": [
						{
							"args": [
								"dest",
								"src"
							],
							"init": {
								"dest": "xxxxxxxxxx",
								"src": "Hello"
							},
							"returns": "Hello",
							"stdout": "",
							"post": {
								"dest": "Hello"
							}
						},
						{
							"args": [
								"dest",
								"src"
							],
							"init": {
								"dest": "xxxxxxxxxx",
								"src": ""
							},
							"returns": "",
							"stdout": "",
							"post": {
								"dest": ""
							}
						},
						{
							"args": [
								"dest",
								"src"
							],
							"init": {
								"dest": "xxxxxxxxxx",
								"src": "42"
							},
							"returns": "42",
							"stdout": "",
							"post": {
								"dest": "42"
							}
						}
					],
					"description": "Reproduce the behavior of strcpy (man strcpy)."
				},
