							"returns": [
								1,
								2,
								3,
								4,
								5
							],
							"stdout": ""
						},
						{
							"args": [
								"data"
							],
							"init": {
								"data": [
									[
										1,
										2
									],
									[
										3,
										4
									]
								]
							},
							"returns": [
								[
									1,
									2
								],
								[
									3,
									4
								]
							],
							"stdout": ""
						}
					],
					"description": "Create a NumPy array from the input list and return it as a list (use .tolist())."
				},
				{
					"name": "array_attributes",
