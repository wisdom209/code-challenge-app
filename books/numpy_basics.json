							},
							"returns": {
								"mean": 6.0,
								"std": 2.8284271247461903,
								"sum": 30
							},
							"stdout": ""
						}
					],
					"description": "Return the mean, standard deviation, and sum of the array as a dict."
				},
				{
					"name": "broadcast_multiply",
					"prototype": "def broadcast_multiply(arr: list, scalar: int) -> list:",
					"type": "function",
					"allowed": [
						"numpy"
					],
					"tests": [
						{
							"args": [
