							],
							"stdout": ""
						}
					],
					"description": "Reshape the 1‑D list into a 2‑D array with the given shape and return as nested list."
				},
				{
					"name": "statistics",
					"prototype": "def statistics(arr: list) -> dict:",
					"type": "function",
					"allowed": [
						"numpy"
					],
					"tests": [
						{
							"args": [
								"arr"
							],
							"init": {
								"arr": [
									2,
									4,
									6,
									8,
									10
