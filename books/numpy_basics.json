								10,
								15
							],
							"stdout": ""
						}
					],
					"description": "Multiply every element of the array by the scalar using broadcasting and return the result as a list."
				},
				{
					"name": "matrix_multiplication",
					"prototype": "def matrix_multiplication(A: list, B: list) -> list:",
					"type": "function",
					"allowed": [
						"numpy"
					],
					"tests": [
						{
							"args": [
								"A",
								"B"
							],
							"init": {
								"A": [
									[
										1,
										2
									],
									[
										3,
										4
									]
								],
								"B": [
									[
										5,
										6
									],
									[
										7,
										8
									]
								]
							},
							"returns": [
								[
									19,
									22
								],
								[
									43,
									50
								]
							],
							"stdout": ""
						}
					],
					"description": "Perform matrix multiplication (dot product) on two 2‑D arrays and return the result as nested list."
				},
				{
					"name": "random_integers",
					"prototype": "def random_integers(low: int, high: int, size: int) -> list:",
					"type": "function",
					"allowed": [
						"numpy"
					],
					"tests": [
						{
							"args": [
								"low",
								"high",
								"size"
							],
							"init": {
								"low": 1,
								"high": 10,
								"size": 5
